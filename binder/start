#!/usr/bin/env bash
set -euo pipefail

cardinal_root="${CARDINAL_ROOT:-${HOME}/cardinal}"
export CARDINAL_ROOT="${cardinal_root}"
export CARDINAL_DIR="${cardinal_root}"
export NEKRS_HOME="${cardinal_root}/install"
export OCCA_CACHE_DIR="${OCCA_CACHE_DIR:-${HOME}/.cache/occa}"
export NEKRS_OCCA_MODE_DEFAULT="${NEKRS_OCCA_MODE_DEFAULT:-CUDA}"

mkdir -p "${OCCA_CACHE_DIR}"

if [[ -x "${cardinal_root}/cardinal-opt" ]]; then
  export PATH="${cardinal_root}:${cardinal_root}/install/bin:${PATH}"
fi

if [[ -z "${OPENMC_CROSS_SECTIONS:-}" ]]; then
  for openmc_cross_sections in \
    "${HOME}/cross_sections/endfb-vii.1-hdf5/cross_sections.xml" \
    "${HOME}/cross_sections/endfb-viii.0-hdf5/cross_sections.xml"; do
    if [[ -f "${openmc_cross_sections}" ]]; then
      export OPENMC_CROSS_SECTIONS="${openmc_cross_sections}"
      break
    fi
  done
fi

exec "$@"
